<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <ImageView android:id="@+id/product_detail_photo" android:layout_width="match_parent" android:layout_height="160dp" android:contentDescription="@string/product_image" android:scaleType="centerCrop" />
        <TextView android:id="@+id/product_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/forest" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/product_detail_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/muted_green" android:textSize="14sp" />
        <com.example.masrouf1.PriceChartView android:id="@+id/product_price_chart" android:layout_width="match_parent" android:layout_height="230dp" android:layout_marginTop="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/purchase_history_title" android:textColor="@color/forest" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/product_purchase_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="@string/purchase_history_empty" android:textColor="@color/muted_green" android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/product_purchase_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
    </LinearLayout>
</ScrollView>
