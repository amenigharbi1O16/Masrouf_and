<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT : activity_congratulations.xml
    ÉCRAN : Félicitations / Succès de budget
    RÔLE : Écran de confirmation positif affiché quand l'utilisateur
           termine une période budgétaire avec succès ou atteint un objectif.
    CORRESPONDANCE RN : src/app/felicitations.tsx
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_botanical_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="64dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- Illustration / Icône principale -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉"
            android:textSize="72sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Titre principal -->
        <TextView
            android:id="@+id/congrats_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/congrats_title"
            android:textColor="@color/forest"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Message explicatif -->
        <TextView
            android:id="@+id/congrats_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/congrats_message"
            android:textColor="@color/muted_green"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp" />

        <!-- Carte de résumé des points gagnés -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/congrats_points_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/mint"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/congrats_points_earned"
                    android:textColor="@color/forest"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/congrats_points_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/forest"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/points_label"
                    android:textColor="@color/muted_green"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte de résumé économies -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/congrats_savings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/alabaster"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/congrats_saved"
                    android:textColor="@color/muted_green"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/congrats_savings_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/emerald"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bouton Retour à l'accueil -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/congrats_home_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/go_home"
            android:textColor="@color/alabaster"
            app:backgroundTint="@color/forest"
            app:cornerRadius="16dp" />

        <!-- Bouton Voir mes points (secondaire) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/congrats_points_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/nav_rewards"
            android:textColor="@color/alabaster"
            app:backgroundTint="@color/emerald"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>
