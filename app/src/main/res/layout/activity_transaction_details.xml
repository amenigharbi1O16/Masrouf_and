<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/transaction_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/forest" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/transaction_detail_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/forest" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:id="@+id/transaction_detail_kind" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/muted_green" android:textSize="15sp" />
    <TextView android:id="@+id/transaction_detail_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" android:textSize="15sp" />
    <TextView android:id="@+id/transaction_detail_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/ink" android:textSize="15sp" />
    <TextView android:id="@+id/transaction_detail_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transaction_details_unavailable" android:textColor="@color/coral" android:visibility="gone" />
</LinearLayout>
