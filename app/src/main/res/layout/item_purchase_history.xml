<?xml version="1.0" encoding="utf-8"?>
<!-- Ligne d'historique d'achat sur la fiche produit (quantité, magasin, date et montant total) pour PurchaseHistoryAdapter -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="10dp">
    <TextView android:id="@+id/purchase_history_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/ink" android:textSize="14sp" />
    <TextView android:id="@+id/purchase_history_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/forest" android:textStyle="bold" />
</LinearLayout>
