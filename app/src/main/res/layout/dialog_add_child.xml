<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_child_name" android:text="@string/child_name_hint" />
    <EditText android:id="@+id/dialog_child_name" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/hint_child_name" android:inputType="textCapWords" android:singleLine="true" />
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_child_email" android:text="@string/child_email" />
    <EditText android:id="@+id/dialog_child_email" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/hint_child_email" android:inputType="textEmailAddress" android:singleLine="true" />
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_child_password" android:text="@string/child_temporary_password" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:endIconMode="password_toggle" xmlns:app="http://schemas.android.com/apk/res-auto">
        <EditText android:id="@+id/dialog_child_password" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/hint_temporary_password" android:inputType="textPassword" android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_rules" android:textColor="@color/muted_green" android:textSize="12sp" />
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_child_phone" android:text="@string/parent_phone" />
    <EditText android:id="@+id/dialog_child_phone" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/hint_phone" android:inputType="phone" android:singleLine="true" />
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_child_allocation" android:text="@string/initial_allocation" />
    <EditText android:id="@+id/dialog_child_allocation" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/hint_initial_allocation" android:inputType="numberDecimal" android:singleLine="true" />
    <TextView android:id="@+id/dialog_child_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coral" />
</LinearLayout>
</ScrollView>
