<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
    <EditText android:id="@+id/dialog_child_name" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/child_name_hint" android:inputType="textCapWords" android:singleLine="true" />
    <EditText android:id="@+id/dialog_child_email" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/child_email" android:inputType="textEmailAddress" android:singleLine="true" />
    <EditText android:id="@+id/dialog_child_password" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/child_temporary_password" android:inputType="textPassword" android:singleLine="true" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/password_rules" android:textColor="@color/muted_green" android:textSize="12sp" />
    <EditText android:id="@+id/dialog_child_phone" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/parent_phone" android:inputType="phone" android:singleLine="true" />
    <EditText android:id="@+id/dialog_child_allocation" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/initial_allocation" android:inputType="numberDecimal" android:singleLine="true" />
    <TextView android:id="@+id/dialog_child_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coral" />
</LinearLayout>
