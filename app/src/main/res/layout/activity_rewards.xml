<?xml version="1.0" encoding="utf-8"?>
<!-- Écran Points et Récompenses (RewardsActivity) : carte niveau vert forêt, barre de progression et journal des points -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/forest" app:cardCornerRadius="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/points_balance_title" android:textColor="@color/mint_accent" android:textSize="14sp" />
                <TextView android:id="@+id/rewards_points" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/alabaster" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:id="@+id/rewards_level" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/alabaster" android:textSize="18sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/rewards_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:max="100" android:progressTint="@color/mint_accent" android:progressBackgroundTint="@color/muted_green" />
                <TextView android:id="@+id/rewards_next_level" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/mint_accent" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/rewards_available_title" android:textColor="@color/forest" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/rewards_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/rewards_empty" android:textColor="@color/muted_green" android:visibility="gone" />
        <LinearLayout android:id="@+id/rewards_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/points_history_title" android:textColor="@color/forest" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/points_history_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="@string/points_history_empty" android:textColor="@color/muted_green" android:visibility="gone" />
        <LinearLayout android:id="@+id/points_history_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
