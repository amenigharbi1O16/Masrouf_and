<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT : activity_change_password.xml
    ÉCRAN : Changer le mot de passe
    RÔLE : Formulaire sécurisé permettant à l'utilisateur connecté de modifier
           son mot de passe actuel en saisissant l'ancien, le nouveau et la confirmation.
    CORRESPONDANCE RN : src/app/changer-mot-de-passe.tsx
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- En-tête avec flèche retour et titre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/change_password_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back"
                android:padding="8dp"
                app:tint="@color/forest" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/change_password_title"
                android:textColor="@color/forest"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/change_password_desc"
            android:textColor="@color/muted_green"
            android:textSize="14sp" />

        <!-- Ancien mot de passe -->
        <TextView
            style="@style/FormFieldLabel"
            android:labelFor="@id/current_password"
            android:text="@string/current_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/current_password"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nouveau mot de passe -->
        <TextView
            style="@style/FormFieldLabel"
            android:labelFor="@id/new_password"
            android:text="@string/new_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/new_password"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Règles de mot de passe -->
        <LinearLayout
            android:id="@+id/password_rules_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:background="@drawable/card_white_rounded"
            android:padding="12dp" />

        <!-- Confirmation nouveau mot de passe -->
        <TextView
            style="@style/FormFieldLabel"
            android:labelFor="@id/confirm_new_password"
            android:text="@string/confirm_password" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/confirm_new_password"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textColor="@color/ink" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Message d'erreur global -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/change_password_error_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/danger_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/coral"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/change_password_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:textColor="@color/danger_text"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Message de succès -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/change_password_success_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/success_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/change_password_success_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:text="@string/password_changed_success"
                android:textColor="@color/emerald"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Bouton Enregistrer -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/change_password_submit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/save_password"
            android:textColor="@color/alabaster"
            app:backgroundTint="@color/forest"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>
