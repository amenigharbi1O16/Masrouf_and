<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/cream">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" app:cardBackgroundColor="@color/alabaster" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <EditText android:id="@+id/expense_label" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/transaction_name" android:singleLine="true" />
            <EditText android:id="@+id/expense_amount" android:layout_width="match_parent" android:layout_height="54dp" android:hint="@string/amount_dinars" android:inputType="numberDecimal" />
            <Spinner android:id="@+id/expense_category" android:layout_width="match_parent" android:layout_height="54dp" />
            <EditText android:id="@+id/expense_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:hint="@string/expense_note" android:minHeight="80dp" android:inputType="textCapSentences|textMultiLine" />
            <TextView android:id="@+id/expense_date" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:hint="@string/expense_date" android:paddingHorizontal="10dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/save_expense" android:layout_width="match_parent" android:layout_height="54dp" android:text="@string/save" app:backgroundTint="@color/forest" app:cornerRadius="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
