<?xml version="1.0" encoding="utf-8"?>
<!-- Summary card item for step 3: selected category with green checkmark -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/alabaster"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Icon circle -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_mint" />

            <ImageView
                android:id="@+id/summary_category_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription=""
                android:tint="@color/emerald" />

        </FrameLayout>

        <!-- Category info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/summary_category_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/forest"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/summary_category_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/muted_green"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Checkmark -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription=""
            android:src="@drawable/ic_check_circle" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
