<?xml version="1.0" encoding="utf-8"?>
<!-- Category row item for onboarding step 2: icon + name + Sélectionner/Sélectionné button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/item_category_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingHorizontal="8dp">

        <!-- Category icon in mint circle -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp">

            <View
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_mint" />

            <ImageView
                android:id="@+id/item_category_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription=""
                android:tint="@color/forest" />

        </FrameLayout>

        <!-- Category name -->
        <TextView
            android:id="@+id/item_category_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/item_category_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/delete_action"
            android:padding="7dp"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@color/coral" />

        <!-- Dynamic toggle button: Sélectionner -> Sélectionné -->
        <TextView
            android:id="@+id/item_category_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center"
            android:background="@drawable/bg_btn_select"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/select_btn"
            android:textColor="@color/alabaster"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_border"
        android:layout_marginStart="50dp" />

</LinearLayout>
