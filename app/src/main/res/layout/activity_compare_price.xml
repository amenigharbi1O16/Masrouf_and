<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/cream">
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" app:cardBackgroundColor="@color/alabaster" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <EditText android:id="@+id/compare_name" android:layout_width="match_parent" android:layout_height="52dp" android:hint="@string/product_name" />
            <EditText android:id="@+id/compare_brand" android:layout_width="match_parent" android:layout_height="52dp" android:hint="@string/product_brand" />
            <EditText android:id="@+id/compare_price" android:layout_width="match_parent" android:layout_height="52dp" android:hint="@string/total_price_dt" android:inputType="numberDecimal" />
            <EditText android:id="@+id/compare_quantity" android:layout_width="match_parent" android:layout_height="52dp" android:hint="@string/quantity" android:inputType="numberDecimal" android:text="1" />
            <Spinner android:id="@+id/compare_unit" android:layout_width="match_parent" android:layout_height="52dp" />
            <Spinner android:id="@+id/compare_category" android:layout_width="match_parent" android:layout_height="52dp" />
            <EditText android:id="@+id/compare_store" android:layout_width="match_parent" android:layout_height="52dp" android:hint="@string/store_name" />
            <TextView android:id="@+id/compare_unit_price" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="@color/forest" android:textStyle="bold" />
            <TextView android:id="@+id/price_indicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/forest" android:textStyle="bold" />
            <TextView android:id="@+id/envelope_impact" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="@color/muted_green" />
            <com.google.android.material.button.MaterialButton android:id="@+id/compare_save" android:layout_width="match_parent" android:layout_height="54dp" android:text="@string/confirm_save_purchase" app:backgroundTint="@color/forest" app:cornerRadius="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
