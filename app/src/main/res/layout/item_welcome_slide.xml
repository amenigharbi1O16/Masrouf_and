<?xml version="1.0" encoding="utf-8"?>
<!-- Single slide for pre-login onboarding ViewPager2 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/alabaster"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Icon circle -->
                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp">

                    <View
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_circle_mint" />

                    <ImageView
                        android:id="@+id/slide_icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription=""
                        android:tint="@color/forest" />

                </FrameLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/slide_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:textColor="@color/forest"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- Body -->
                <TextView
                    android:id="@+id/slide_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.35"
                    android:textColor="@color/muted_green"
                    android:textSize="14sp" />

                <!-- Bullet 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/slide_bullet1_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_check_circle" />

                    <TextView
                        android:id="@+id/slide_bullet1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Bullet 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/slide_bullet2_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_check_circle" />

                    <TextView
                        android:id="@+id/slide_bullet2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
