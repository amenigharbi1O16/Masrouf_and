<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/register_title" android:textColor="@color/forest" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/register_type" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/muted_green" />
        <TextView style="@style/FormFieldLabel" android:labelFor="@id/register_name" android:text="@string/full_name" />
        <EditText android:id="@+id/register_name" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="18dp" android:hint="@string/hint_full_name" android:inputType="textPersonName|textCapWords" android:singleLine="true" />
        <TextView style="@style/FormFieldLabel" android:labelFor="@id/register_email" android:text="@string/email_address" />
        <EditText android:id="@+id/register_email" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/hint_email" android:inputType="textEmailAddress" android:singleLine="true" />
        <TextView android:id="@+id/register_email_feedback" android:layout_width="match_parent" android:layout_height="24dp" android:textColor="@color/coral" android:textSize="12sp" />
        <TextView style="@style/FormFieldLabel" android:labelFor="@id/register_password" android:text="@string/password" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:endIconMode="password_toggle">
            <EditText android:id="@+id/register_password" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/hint_password" android:inputType="textPassword" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/rule_length" android:layout_width="match_parent" android:layout_height="28dp" android:text="@string/password_length" android:textColor="@color/muted_green" />
        <TextView android:id="@+id/rule_uppercase" android:layout_width="match_parent" android:layout_height="28dp" android:text="@string/password_uppercase" android:textColor="@color/muted_green" />
        <TextView android:id="@+id/rule_lowercase" android:layout_width="match_parent" android:layout_height="28dp" android:text="@string/password_lowercase" android:textColor="@color/muted_green" />
        <TextView android:id="@+id/rule_number" android:layout_width="match_parent" android:layout_height="28dp" android:text="@string/password_number" android:textColor="@color/muted_green" />
        <TextView android:id="@+id/rule_symbol" android:layout_width="match_parent" android:layout_height="28dp" android:text="@string/password_symbol" android:textColor="@color/muted_green" />
        <TextView style="@style/FormFieldLabel" android:labelFor="@id/register_confirm" android:text="@string/confirm_password" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:endIconMode="password_toggle">
            <EditText android:id="@+id/register_confirm" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/hint_confirm_password" android:inputType="textPassword" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/register_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coral" />
        <com.google.android.material.button.MaterialButton android:id="@+id/register_submit" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp" android:text="@string/register_action" app:backgroundTint="@color/forest" app:cornerRadius="16dp" />
    </LinearLayout>
</ScrollView>
