<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'entrée LAUNCHER (WelcomeActivity) : Phase 1 logo/Commencer + Phase 2 carrousel ViewPager2 à 3 diapositives -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:layoutDirection="locale">

    <!-- Botanical decoration top-left (dark circle) -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-60dp"
        android:layout_marginTop="-60dp"
        android:background="@drawable/bg_circle_forest" />

    <!-- Botanical decoration top-left (mint circle) -->
    <View
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_circle_mint" />

    <!-- Botanical decoration bottom-right (dark circle) -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="-90dp"
        android:background="@drawable/bg_circle_forest" />

    <!-- Botanical decoration bottom-right (mint circle) -->
    <View
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="-40dp"
        android:background="@drawable/bg_circle_mint" />

    <!-- Main content (respects system status & navigation bar insets) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <!-- Language row top right -->
        <LinearLayout
            android:id="@+id/welcome_languages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:padding="16dp" />

        <!-- Phase container (fills remaining space) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- PHASE 1: Welcome splash -->
            <LinearLayout
                android:id="@+id/phase_welcome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_masrouf_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/welcome_bienvenue_sur"
                    android:textColor="@color/muted_green"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/forest"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <!-- Underline accent -->
                <View
                    android:layout_width="80dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/emerald" />

            </LinearLayout>

            <!-- PHASE 2: 3-slide intro carousel -->
            <LinearLayout
                android:id="@+id/phase_slides"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:visibility="gone">

                <!-- Back button row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/slide_back"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/back"
                        android:padding="10dp"
                        android:src="@drawable/ic_back"
                        app:tint="@color/forest" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/slide_skip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="@string/welcome_skip"
                        android:textColor="@color/muted_green"
                        android:textSize="15sp" />

                </LinearLayout>

                <!-- ViewPager for slides -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/welcome_pager"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1" />

                <!-- Dot indicators -->
                <LinearLayout
                    android:id="@+id/slide_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal" />

            </LinearLayout>

            <!-- PHASE 3: Account type selection — now a separate Activity -->
        </FrameLayout>

        <!-- Bottom buttons (Welcome phase) -->
        <LinearLayout
            android:id="@+id/welcome_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="32dp"
            android:paddingTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start_welcome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/start"
                android:textColor="@color/alabaster"
                android:textSize="17sp"
                app:backgroundTint="@color/forest"
                app:cornerRadius="28dp" />

            <TextView
                android:id="@+id/open_login"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:text="@string/already_account_link"
                android:textColor="@color/muted_green"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Bottom buttons (Slide phase) -->
        <LinearLayout
            android:id="@+id/slide_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="32dp"
            android:paddingTop="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slide_next"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/welcome_next"
                android:textColor="@color/alabaster"
                android:textSize="17sp"
                app:backgroundTint="@color/forest"
                app:cornerRadius="28dp" />

            <TextView
                android:id="@+id/slide_open_login"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:text="@string/already_account_link"
                android:textColor="@color/muted_green"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
