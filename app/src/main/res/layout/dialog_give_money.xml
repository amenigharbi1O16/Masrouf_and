<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_gift_amount" android:text="@string/gift_amount" />
    <EditText android:id="@+id/dialog_gift_amount" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/hint_amount" android:inputType="numberDecimal" android:singleLine="true" />
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_gift_note" android:text="@string/gift_note" />
    <EditText android:id="@+id/dialog_gift_note" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/hint_note" android:inputType="textCapSentences" android:maxLines="2" />
    <TextView android:id="@+id/dialog_gift_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coral" />
</LinearLayout>
