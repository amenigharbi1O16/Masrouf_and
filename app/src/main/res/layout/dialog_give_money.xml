<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_gift_amount" android:text="@string/gift_amount" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" xmlns:app="http://schemas.android.com/apk/res-auto">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/dialog_gift_amount" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/hint_amount" android:inputType="numberDecimal" android:singleLine="true" android:textColor="@color/ink" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView style="@style/FormFieldLabel" android:labelFor="@id/dialog_gift_note" android:text="@string/gift_note" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" xmlns:app="http://schemas.android.com/apk/res-auto">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/dialog_gift_note" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/expense_note" android:inputType="text" android:singleLine="true" android:textColor="@color/ink" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/dialog_gift_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/coral" />
</LinearLayout>
