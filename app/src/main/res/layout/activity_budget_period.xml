<?xml version="1.0" encoding="utf-8"?>
<!-- Sélection de période budgétaire (BudgetPeriodActivity) : champs dates ISO, calendrier interactif Java, plafond en DT -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/budget_period_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/forest" />

        <TextView
            android:id="@+id/budget_period_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/create_budget_title"
            android:textColor="@color/forest"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/budget_period_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/muted_green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/budget_period_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/budget_period_headline"
                android:textColor="@color/forest"
                android:textSize="21sp"
                android:textStyle="bold" />

            <!-- Closed period / Error / Duplicate warning banner -->
            <com.example.masrouf1.ui.AlertBannerView
                android:id="@+id/budget_period_alert_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/budget_period_edit_existing_btn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="@string/edit_existing_budget"
                android:textColor="@color/alabaster"
                android:textStyle="bold"
                android:visibility="gone"
                app:backgroundTint="@color/forest"
                app:cornerRadius="16dp" />

            <!-- Info banner matching React Native Créer un budget -->
            <com.example.masrouf1.ui.AlertBannerView
                android:id="@+id/budget_period_top_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- Start Date Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budget_start_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/alabaster"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/budget_start_date"
                            android:text="@string/budget_start_date_iso"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/budget_start_date"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@android:color/transparent"
                            android:hint="2026-11-01"
                            android:inputType="date"
                            android:maxLines="1"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/budget_start_cal_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_mint"
                        android:contentDescription="@string/calendar_picker_open"
                        android:padding="9dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/forest" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- End Date Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budget_end_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/alabaster"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/budget_end_date"
                            android:text="@string/budget_end_date_iso"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/budget_end_date"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@android:color/transparent"
                            android:hint="2026-11-30"
                            android:inputType="date"
                            android:maxLines="1"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/budget_end_cal_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_mint"
                        android:contentDescription="@string/calendar_picker_open"
                        android:padding="9dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/forest" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Toggle button for interactive visual calendar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/budget_toggle_calendar_btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/calendar_picker_open"
                android:textColor="@color/forest"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@color/mint_light"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_calendar"
                app:iconSize="16dp"
                app:iconTint="@color/forest" />

            <!-- Complete Interactive Month Calendar Interface -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/budget_calendar_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="visible"
                app:cardBackgroundColor="@color/alabaster"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Mode switcher: Picking Start vs Picking End -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/calendar_pick_mode_start"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:padding="0dp"
                            android:text="@string/calendar_pick_start"
                            android:textColor="@color/alabaster"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/forest"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/calendar_pick_mode_end"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:padding="0dp"
                            android:text="@string/calendar_pick_end"
                            android:textColor="@color/forest"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/mint_light"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <!-- Month navigation bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/budget_cal_prev_month"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:minWidth="44dp"
                            android:padding="0dp"
                            android:text="‹"
                            android:textColor="@color/forest"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/budget_cal_month_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="@color/forest"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/budget_cal_next_month"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:minWidth="44dp"
                            android:padding="0dp"
                            android:text="›"
                            android:textColor="@color/forest"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/budget_cal_weekdays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/budget_cal_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Total Budget Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/alabaster"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/budget_total_input"
                        android:text="@string/budget_total_dt_label"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/budget_total_input"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@android:color/transparent"
                        android:hint="1200.000"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Days / pay-cycle info banner -->
            <com.example.masrouf1.ui.AlertBannerView
                android:id="@+id/budget_period_days_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/budget_period_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/coral"
                android:textStyle="bold"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/budget_period_continue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="@string/allocate_by_category_cta"
                android:textColor="@color/alabaster"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/emerald"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/budget_period_cancel"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="@string/cancel_btn"
                android:textColor="@color/forest"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/mint_light"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
