<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet Calendrier financier annuel (CalendarFragment) : sélecteur année, grille 12 mois, périodes budgétaires et opérations du mois -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:letterSpacing="0.06"
        android:text="@string/calendar_eyebrow"
        android:textAllCaps="true"
        android:textColor="@color/muted_green"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Year switcher header matching React Native Calendrier -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calendar_previous"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/calendar_prev_year"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="‹"
            android:textColor="@color/forest"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/calendar_month_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/forest"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calendar_next"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/calendar_next_year"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="›"
            android:textColor="@color/forest"
            android:textSize="26sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:text="@string/calendar_subtitle"
        android:textColor="@color/muted_green"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/calendar_loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/calendar_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/coral"
        android:visibility="gone" />

    <!-- 2-column 12-month financial grid -->
    <LinearLayout
        android:id="@+id/calendar_months_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Selected Month Header -->
    <TextView
        android:id="@+id/calendar_selected_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/forest"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- Empty state card for selected month with no overlapping budgets -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/calendar_empty_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/alabaster"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_circle_mint">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/emerald" />
            </FrameLayout>

            <TextView
                android:id="@+id/calendar_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/calendar_no_budget_title"
                android:textColor="@color/forest"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/calendar_empty_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/calendar_no_budget_detail"
                android:textColor="@color/muted_green"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calendar_create_period_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/calendar_create_budget"
                android:textColor="@color/alabaster"
                android:textStyle="bold"
                app:backgroundTint="@color/emerald"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Overlapping budget periods for selected month -->
    <LinearLayout
        android:id="@+id/calendar_budget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/calendar_add_another_btn"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:text="@string/calendar_new_period"
        android:textColor="@color/alabaster"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/emerald"
        app:cornerRadius="16dp" />

    <!-- Monthly transactions for historical consultation -->
    <TextView
        android:id="@+id/calendar_transactions_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/calendar_month_transactions"
        android:textColor="@color/forest"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/calendar_day_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/emerald"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/calendar_day_transactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp" />
</LinearLayout>
