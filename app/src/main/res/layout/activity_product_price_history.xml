<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT : activity_product_price_history.xml
    ÉCRAN : Historique des prix d'un produit
    RÔLE : Affiche la liste chronologique de tous les achats d'un article
           avec le prix unitaire, la quantité, le magasin et la date.
    CORRESPONDANCE RN : src/app/produit/historique.tsx
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <!-- En-tête avec flèche retour et nom du produit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/alabaster">

        <ImageView
            android:id="@+id/price_history_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:padding="8dp"
            app:tint="@color/forest" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/price_history_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/price_history_title"
                android:textColor="@color/forest"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/price_history_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/price_history_subtitle"
                android:textColor="@color/muted_green"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chargement -->
    <LinearLayout
        android:id="@+id/price_history_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="24dp"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/loading"
            android:textColor="@color/muted_green" />
    </LinearLayout>

    <!-- État vide -->
    <LinearLayout
        android:id="@+id/price_history_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/price_history_empty"
            android:textColor="@color/muted_green"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Liste des achats -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/price_history_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone" />

</LinearLayout>
