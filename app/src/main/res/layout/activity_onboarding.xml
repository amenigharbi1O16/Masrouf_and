<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/onboarding_step_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/muted_green" android:textSize="12sp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/onboarding_step_one" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="14dp">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/forest" app:cardCornerRadius="24dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/onboarding_discover" android:textColor="@color/alabaster" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/onboarding_discover_body" android:textColor="@color/mint" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/alabaster" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="90dp" android:padding="18dp" android:text="@string/onboarding_transactions_empty" android:textColor="@color/muted_green" /></com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/onboarding_step_two" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="@string/onboarding_categories" android:textColor="@color/forest" android:textSize="20sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/onboarding_category_list" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="12dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/onboarding_step_three" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="@string/onboarding_summary" android:textColor="@color/forest" android:textSize="22sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/onboarding_summary_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/no_budget" android:textColor="@color/muted_green" />
            </LinearLayout>
        </FrameLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/onboarding_next" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/choose_categories" app:backgroundTint="@color/forest" app:cornerRadius="16dp" />
    </LinearLayout>
</FrameLayout>
