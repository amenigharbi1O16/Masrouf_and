<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/family_analytics_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/forest"
        android:elevation="2dp"
        app:navigationIconTint="@color/alabaster"
        app:title="@string/nav_budget_analytics"
        app:titleTextColor="@color/alabaster" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <ProgressBar
                android:id="@+id/family_analytics_loading"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/family_analytics_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_read_error"
                android:textColor="@color/coral"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/family_analytics_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
