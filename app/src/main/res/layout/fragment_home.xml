<?xml version="1.0" encoding="utf-8"?>
<!-- Tableau de bord Accueil adaptatif (HomeFragment) : BudgetCardView, alertes seuils, enveloppes catégories, transactions et suivi Enfants -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_botanical_page" android:clipToPadding="false" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="26dp" android:paddingEnd="20dp" android:paddingBottom="96dp">
        <!-- 1. Header and current period -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/home_open_drawer" android:layout_width="42dp" android:layout_height="48dp" android:contentDescription="@string/open_menu" android:gravity="center" android:text="☰" android:textColor="@color/forest" android:textSize="20sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/home_greeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/greeting_hello" android:textColor="@color/forest" android:textSize="24sp" android:textStyle="bold" />
                <TextView android:id="@+id/home_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/period_november" android:textColor="@color/muted_green" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/home_calendar_link" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="@string/calendar_link" android:textColor="@color/emerald" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/home_loading_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ProgressBar android:layout_width="24dp" android:layout_height="24dp" android:indeterminate="true" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/dashboard_loading" android:textColor="@color/muted_green" />
        </LinearLayout>
        <TextView android:id="@+id/home_error_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="12dp" android:text="@string/dashboard_read_error" android:textColor="@color/coral" android:visibility="gone" />

        <!-- 2. Main budget card -->
        <com.example.masrouf1.ui.BudgetCardView android:id="@+id/home_budget_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" />

        <TextView android:id="@+id/home_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/card_white_rounded" android:padding="14dp" android:textColor="@color/ink" android:textSize="14sp" android:visibility="gone" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/home_child_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" app:cardBackgroundColor="@color/alabaster" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/child_money_summary_title" android:textColor="@color/forest" android:textStyle="bold" />
                <TextView android:id="@+id/home_child_received" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/ink" />
                <TextView android:id="@+id/home_child_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/muted_green" />
                <ProgressBar android:id="@+id/home_child_goal_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:max="100" android:progressTint="@color/emerald" android:progressBackgroundTint="@color/mint_light" />
                <com.google.android.material.button.MaterialButton android:id="@+id/home_request_money" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="@string/child_request_money" android:textColor="@color/alabaster" app:backgroundTint="@color/forest" app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. The only add-category control: directly beneath the hero card -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end|center_vertical" android:layoutDirection="locale" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/home_add_category" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="@string/add_category" android:textColor="@color/alabaster" android:textStyle="bold" app:icon="@drawable/ic_add_circle" app:iconTint="@color/alabaster" app:backgroundTint="@color/emerald" app:cornerRadius="28dp" />
        </LinearLayout>

        <!-- 4. Empty budget callout (hidden once a budget exists) -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/home_no_budget" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/alabaster" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/home_no_budget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_budget" android:textColor="@color/ink" android:textStyle="bold" />
                <TextView android:id="@+id/home_child_no_budget_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/no_child_budget" android:textColor="@color/muted_green" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/home_define_budget" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/define_budget" android:textColor="@color/alabaster" app:backgroundTint="@color/emerald" app:cornerRadius="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Dynamic threshold alert -->
        <com.example.masrouf1.ui.AlertBannerView android:id="@+id/home_threshold_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />

        <!-- 6. Two equal primary actions -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/home_add_purchase" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="@string/add_purchase_product" android:textColor="@color/alabaster" android:textSize="12sp" app:icon="@drawable/ic_cart" app:iconTint="@color/mint" app:backgroundTint="@color/forest" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/home_add_expense" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="6dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:text="@string/add_expense" android:textColor="@color/alabaster" android:textSize="12sp" app:icon="@drawable/ic_receipt" app:iconTint="@color/alabaster" app:backgroundTint="@color/emerald" app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- 7. User categories -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/your_categories" android:textColor="@color/forest" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/home_allocate_repartition" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_btn_secondary_mint" android:gravity="center" android:paddingHorizontal="12dp" android:text="@string/adjust_repartition" android:textColor="@color/forest" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/home_manage_categories" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:text="@string/category_manage" android:textColor="@color/emerald" android:textStyle="bold" />
        </LinearLayout>
        <com.example.masrouf1.ui.AlertBannerView android:id="@+id/home_category_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/home_categories" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/home_categories_toggle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:text="@string/see_all_count"
            android:textColor="@color/forest"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@color/mint_light"
            app:cornerRadius="14dp" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/home_categories_empty_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" app:cardBackgroundColor="@color/alabaster" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/no_followed_categories_title" android:textColor="@color/forest" android:textSize="14sp" android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/home_choose_categories_btn" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="@string/choose_my_categories_btn" android:textColor="@color/alabaster" android:textStyle="bold" app:backgroundTint="@color/emerald" app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 8. Family children tracking stays hidden for a personal account -->
        <com.google.android.material.card.MaterialCardView android:id="@+id/home_children_tracking" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:cardBackgroundColor="@color/alabaster" app:cardCornerRadius="16dp" app:strokeColor="@color/card_border" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/children_tracking" android:textColor="@color/forest" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/home_manage_children" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:text="@string/manage_children" android:textColor="@color/emerald" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/home_children_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 9. Five most recent local operations -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/recent_transactions" android:textColor="@color/forest" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/home_transactions_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:text="@string/dashboard_transactions_empty" android:textColor="@color/muted_green" android:visibility="gone" />
        <LinearLayout android:id="@+id/home_recent_transactions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="6dp" />
    </LinearLayout>
</ScrollView>
