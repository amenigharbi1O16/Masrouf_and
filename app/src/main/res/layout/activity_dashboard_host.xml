<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/user_drawer" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream" android:fitsSystemWindows="true">
    <FrameLayout android:id="@+id/dashboard_frame" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream">
        <androidx.fragment.app.FragmentContainerView android:id="@+id/dashboard_fragment_host" android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/voice_transaction_button" android:layout_width="58dp" android:layout_height="58dp" android:layout_gravity="bottom|end" android:layout_marginEnd="18dp" android:layout_marginBottom="24dp" android:contentDescription="@string/voice_transaction" android:src="@drawable/ic_mic_mint" app:backgroundTint="@color/forest" app:borderWidth="0dp" app:elevation="8dp" app:tint="@color/mint" />
    </FrameLayout>
    <!-- Conteneur unique de tiroir start pour DrawerLayout -->
    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:id="@+id/personal_drawer_panel"
            android:layout_width="@dimen/drawer_width"
            android:layout_height="match_parent"
            android:background="@color/alabaster"
            android:elevation="16dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="38dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/forest"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/personal_drawer_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/personal_drawer_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/drawer_personal"
                android:textColor="@color/forest"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/drawer_menu_items"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="22dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/drawer_language"
                android:textColor="@color/muted_green"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/personal_language_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/personal_logout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/logout"
                android:textColor="@color/coral"
                app:cornerRadius="16dp"
                app:strokeColor="@color/coral" />
        </LinearLayout>

        <include layout="@layout/drawer_admin" />
    </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>
