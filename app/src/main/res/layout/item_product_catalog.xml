<?xml version="1.0" encoding="utf-8"?>
<!-- Carte produit du catalogue (ProductCatalogAdapter) : miniature photo/icône, nom, marque/catégorie, dernier prix et variation -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/alabaster"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <ImageView android:id="@+id/product_catalog_image" android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/card_white_rounded" android:contentDescription="@string/product_image" android:padding="8dp" android:scaleType="centerCrop" android:src="@drawable/ic_bag" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/product_catalog_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/forest" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/product_catalog_brand_category" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/muted_green" android:textSize="13sp" />
            <TextView android:id="@+id/product_catalog_price_store" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/forest" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/product_catalog_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
