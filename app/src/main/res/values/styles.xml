<resources>
    <style name="FormFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Masrouf.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Masrouf.Financial" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/forest</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Masrouf.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>
    <style name="TextAppearance.Masrouf.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_secondary</item>
    </style>
    <style name="Widget.Masrouf.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/forest</item>
        <item name="android:textColor">@color/alabaster</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:minHeight">52dp</item>
    </style>
    <style name="Widget.Masrouf.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/alabaster</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">@dimen/stroke_card</item>
    </style>
    <style name="TextAppearance.Masrouf.FormFieldLabel" parent="FormFieldLabel" />

    <style name="Widget.Masrouf.Button" parent="Widget.Masrouf.Button.Primary" />

    <style name="Widget.Masrouf.Button.Secondary" parent="Widget.Masrouf.Button.Outlined">
        <item name="android:textColor">@color/black</item>
    </style>
</resources>
