<!-- Thème principal Material 3 clair/beige chaud sans violet ni gris, avec overlays Dialog, DatePicker et BottomSheet -->
<resources>
    <!-- Base light & warm-beige Masrouf theme: zero purple, zero grey forms, crisp black form text -->
    <style name="Base.Theme.Masrouf1" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorOnPrimary">@color/alabaster</item>
        <item name="colorPrimaryContainer">@color/mint</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/emerald</item>
        <item name="colorOnSecondary">@color/alabaster</item>
        <item name="colorSecondaryContainer">@color/mint_light</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="colorTertiary">@color/emerald</item>
        <item name="colorOnTertiary">@color/alabaster</item>
        <item name="colorTertiaryContainer">@color/mint</item>
        <item name="colorOnTertiaryContainer">@color/black</item>

        <!-- Zero purple across all Material3 / AppCompat widget states -->
        <item name="colorControlActivated">@color/emerald</item>
        <item name="colorControlHighlight">@color/mint</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="colorAccent">@color/emerald</item>
        <item name="android:colorAccent">@color/emerald</item>
        <item name="android:textColorHighlight">@color/mint</item>

        <!-- Warm off-white / beige surfaces instead of grey or lavender -->
        <item name="colorSurface">@color/alabaster</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/form_beige</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="colorSurfaceContainerLowest">@color/alabaster</item>
        <item name="colorSurfaceContainerLow">@color/form_beige</item>
        <item name="colorSurfaceContainer">@color/form_beige</item>
        <item name="colorSurfaceContainerHigh">@color/form_beige</item>
        <item name="colorSurfaceContainerHighest">@color/mint</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="colorOnBackground">@color/black</item>

        <item name="colorError">@color/coral</item>
        <item name="colorOnError">@color/alabaster</item>
        <item name="colorOutline">@color/input_border</item>
        <item name="colorOutlineVariant">@color/card_border</item>

        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="textColorAlertDialogListItem">@color/black</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:colorEdgeEffect">@color/emerald</item>

        <!-- Component overrides -->
        <item name="textInputStyle">@style/Widget.Masrouf.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.Masrouf.EditText</item>
        <item name="spinnerStyle">@style/Widget.Masrouf.Spinner</item>
        <item name="android:spinnerStyle">@style/Widget.Masrouf.Spinner</item>
        <item name="spinnerDropDownItemStyle">@style/Widget.Masrouf.SpinnerDropDownItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/Widget.Masrouf.SpinnerDropDownItem</item>
        <item name="checkboxStyle">@style/Widget.Masrouf.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.Masrouf.RadioButton</item>
        <item name="android:checkedTextViewStyle">@style/Widget.Masrouf.CheckedTextView</item>
        <item name="chipStyle">@style/Widget.Masrouf.Chip</item>
        <item name="materialButtonStyle">@style/Widget.Masrouf.Button.Material</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Masrouf.Button.Outlined</item>

        <!-- Dialog & DatePicker overlays: AppCompat + Material + Android DatePicker -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Masrouf.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Masrouf.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Masrouf.AlertDialog</item>
        <item name="android:datePickerDialogTheme">@style/ThemeOverlay.Masrouf.DatePicker</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Masrouf.BottomSheet</item>
    </style>

    <style name="Theme.Masrouf1" parent="Base.Theme.Masrouf1" />

    <style name="Widget.Masrouf.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/form_beige</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">@color/text_input_stroke_color</item>
        <item name="cursorColor">@color/emerald</item>
        <item name="endIconTint">@color/black</item>
        <item name="startIconTint">@color/black</item>
        <item name="hintEnabled">false</item>
        <item name="hintTextColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.Masrouf.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
    </style>

    <style name="Widget.Masrouf.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:background">@drawable/bg_allocation_input</item>
    </style>

    <style name="Widget.Masrouf.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_dropdown_beige</item>
        <item name="android:background">@drawable/bg_allocation_input</item>
    </style>

    <style name="Widget.Masrouf.SpinnerDropDownItem" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@color/form_beige</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Masrouf.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/masrouf_check_tint</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Widget.Masrouf.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="buttonTint">@color/masrouf_check_tint</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Widget.Masrouf.CheckedTextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@color/form_beige</item>
        <item name="android:checkMarkTint">@color/emerald</item>
    </style>

    <style name="Widget.Masrouf.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="chipStrokeColor">@color/chip_stroke_color</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="checkedIconTint">@color/emerald</item>
    </style>

    <style name="Widget.Masrouf.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/form_beige</item>
        <item name="android:textColor">@color/black</item>
        <item name="strokeColor">@color/input_border</item>
        <item name="iconTint">@color/black</item>
    </style>

    <style name="ThemeOverlay.Masrouf.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorSecondary">@color/emerald</item>
        <item name="colorControlActivated">@color/emerald</item>
        <item name="colorSurface">@color/form_beige</item>
        <item name="colorSurfaceContainerHigh">@color/form_beige</item>
        <item name="android:windowBackground">@drawable/bg_dropdown_beige</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="textColorAlertDialogListItem">@color/black</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Masrouf.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Masrouf.DialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Masrouf.DialogButton.Negative</item>
    </style>

    <style name="ThemeOverlay.Masrouf.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/emerald</item>
        <item name="colorOnPrimary">@color/alabaster</item>
        <item name="colorSecondary">@color/forest</item>
        <item name="colorOnSecondary">@color/alabaster</item>
        <item name="colorSurface">@color/form_beige</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceContainerHigh">@color/form_beige</item>
        <item name="android:colorAccent">@color/emerald</item>
        <item name="android:headerBackground">@color/forest</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Masrouf.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Masrouf.DialogButton.Negative</item>
    </style>

    <style name="ThemeOverlay.Masrouf.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorPrimary">@color/emerald</item>
        <item name="colorSurface">@color/form_beige</item>
        <item name="colorSurfaceContainerLow">@color/form_beige</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
    </style>

    <style name="Widget.Masrouf.DialogButton.Positive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/emerald</item>
        <item name="android:textColor">@color/alabaster</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Masrouf.DialogButton.Negative" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/form_beige</item>
        <item name="android:textColor">@color/black</item>
        <item name="strokeColor">@color/input_border</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.Masrouf.Button.Material" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/forest</item>
        <item name="android:textColor">@color/alabaster</item>
    </style>
</resources>
