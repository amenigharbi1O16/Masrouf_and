<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Maintain warm beige surfaces, black readable form text, and green CTAs consistently -->
    <style name="Base.Theme.Masrouf1" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorOnPrimary">@color/alabaster</item>
        <item name="colorPrimaryContainer">@color/mint</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/emerald</item>
        <item name="colorOnSecondary">@color/alabaster</item>
        <item name="colorSecondaryContainer">@color/mint_light</item>
        <item name="colorOnSecondaryContainer">@color/black</item>
        <item name="colorTertiary">@color/emerald</item>
        <item name="colorOnTertiary">@color/alabaster</item>

        <item name="colorControlActivated">@color/emerald</item>
        <item name="colorControlHighlight">@color/mint</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="colorAccent">@color/emerald</item>
        <item name="android:colorAccent">@color/emerald</item>
        <item name="android:textColorHighlight">@color/mint</item>

        <item name="colorSurface">@color/alabaster</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/form_beige</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="colorSurfaceContainerLowest">@color/alabaster</item>
        <item name="colorSurfaceContainerLow">@color/form_beige</item>
        <item name="colorSurfaceContainer">@color/form_beige</item>
        <item name="colorSurfaceContainerHigh">@color/form_beige</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorError">@color/coral</item>
        <item name="colorOutline">@color/input_border</item>
        <item name="colorOutlineVariant">@color/card_border</item>

        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="textColorAlertDialogListItem">@color/black</item>

        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>

        <item name="textInputStyle">@style/Widget.Masrouf.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.Masrouf.EditText</item>
        <item name="spinnerStyle">@style/Widget.Masrouf.Spinner</item>
        <item name="android:spinnerStyle">@style/Widget.Masrouf.Spinner</item>
        <item name="spinnerDropDownItemStyle">@style/Widget.Masrouf.SpinnerDropDownItem</item>
        <item name="android:spinnerDropDownItemStyle">@style/Widget.Masrouf.SpinnerDropDownItem</item>
        <item name="checkboxStyle">@style/Widget.Masrouf.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.Masrouf.RadioButton</item>
        <item name="android:checkedTextViewStyle">@style/Widget.Masrouf.CheckedTextView</item>
        <item name="chipStyle">@style/Widget.Masrouf.Chip</item>
        <item name="materialButtonStyle">@style/Widget.Masrouf.Button.Material</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Masrouf.Button.Outlined</item>

        <item name="alertDialogTheme">@style/ThemeOverlay.Masrouf.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Masrouf.AlertDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Masrouf.AlertDialog</item>
        <item name="android:datePickerDialogTheme">@style/ThemeOverlay.Masrouf.DatePicker</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Masrouf.BottomSheet</item>
    </style>
</resources>
