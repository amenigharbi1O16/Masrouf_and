<?xml version="1.0" encoding="utf-8"?>
<!-- Sélecteur de couleur de fond des Chip Material : vert menthe si coché/sélectionné, blanc sinon -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/mint" android:state_checked="true" />
    <item android:color="@color/mint" android:state_selected="true" />
    <item android:color="@color/alabaster" />
</selector>
